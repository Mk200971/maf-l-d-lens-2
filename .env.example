# ─────────────────────────────────────────────────────────────────────────────
# MAF L&D Lens — environment variables
#
# This file lists every variable the app reads via process.env. Real values
# belong in Vercel project settings (Project → Settings → Environment Variables)
# and NEVER in this repo. Do not commit a real .env file — .gitignore already
# excludes .env, .env.local, and .env.* (with the explicit exception of
# this .env.example).
# ─────────────────────────────────────────────────────────────────────────────

# Basic-auth credentials for the dashboard (middleware.ts).
# Required in production — the app fails closed (503) if either is unset.
# Pick a long random value for the password; do not reuse a personal password.
DASHBOARD_USER=your-username
DASHBOARD_PASSWORD=use-a-long-random-value

# Model id used by /api/chat. Defaults to 'alibaba/qwen3.7-flash' if unset.
# Useful for A/B testing models or pointing at a specific provider.
CHAT_MODEL=alibaba/qwen-3-235b

# ─────────────────────────────────────────────────────────────────────────────
# Notes
#
# • NODE_ENV is set automatically by Next.js ('production' / 'development')
#   and is intentionally NOT listed here.
#
# • The middleware reads DASHBOARD_USER + DASHBOARD_PASSWORD in production
#   only. In development, both can be left unset and the app will serve
#   without auth (convenient for local iteration).
# ─────────────────────────────────────────────────────────────────────────────
